# A sample environment for the module. The real file is called .env, sits beside
# docker-compose.yml and does NOT go into git (see .gitignore at the repo root).
#
# docker compose picks .env up from the project directory ITSELF, which is exactly
# why the secret is set here rather than through env_file:. The difference is not
# obvious and it matters: env_file: hands variables into the container but does
# NOT take part in ${...} substitution inside the compose file, so the guard
# ${SEARXNG_SECRET:?...} would not fire and the module would come up with a public
# key.

# The session/cookie signing key of the metasearch. One requirement: a long random
# string, not one taken from the history of this or a neighbouring repository.
# One way to make one:
#
#     echo "SEARXNG_SECRET=$(openssl rand -hex 32)" >> .env
#
# Without a value here `up` refuses, by design — the metasearch itself would not
# fail, it would come up with the publicly known key from its image template.
# Rotation means replacing the value and restarting the metasearch; user sessions
# are lost, and there are no other consequences.
SEARXNG_SECRET=

# THE MODEL. The provider is not hard-wired: ANY provider speaking an
# OpenAI-compatible protocol will do. Your key, your base URL, your model names.
#
# Needed by deep search (`ag.deep/2`) and by ONE branch of reading — a PDF with no
# text layer, which is recognised by a vision model. Search, image search and
# screenshots never call a model, and reading calls one only on that branch.
#
# Empty values are a legitimate state, not a breakage: the capabilities declare
# themselves unavailable and name the variable as the reason. A silent "nothing
# was found" instead of "the model is not configured" would be a lie.
LLM_API_KEY=
LLM_API_BASE=

# The name of the text model at YOUR provider. There is deliberately no default: a
# hard-wired name would, with somebody else's key, silently go asking for a model
# that provider does not have, and its refusal would read as a broken service.
LLM_MODEL_TEXT=

# The name of the model WITH VISION. Separate, because not every provider has
# vision and it is priced differently. Left unset, a scanned PDF honestly answers
# "no text layer, recognition is not configured" rather than calling the text
# model with a picture.
LLM_MODEL_VISION=

# Prices per 1000 tokens, if you know them. Empty means `cost_usd: null` in the
# answer, and that is the RIGHT answer rather than an omission: the tariffs of an
# arbitrary provider are unknown to us. The module returns the tokens and the model
# name; money is counted by whoever holds the price registry. An invented price is
# worse than a missing one — somebody will cite it.
LLM_PRICE_INPUT_PER_1K=
LLM_PRICE_OUTPUT_PER_1K=

# TWO WAYS A MODEL ANSWER COMES BACK EMPTY, and the knob for the second one.
#
# A provider that reasons by default spends the token budget on reasoning before
# it says anything. If the budget runs out first, `content` arrives EMPTY — the
# model said nothing out loud, which is not the same event as "found nothing".
# The two are told apart without any setting: such an answer carries
# `finish_reason: length`, and it comes out to the caller as `answer_truncated`.
#
# The second way is a refusal to the field itself. `thinking: {type: disabled}`
# is not part of the OpenAI protocol, so a strict provider answers
# `400: Unrecognized request argument supplied: thinking`. That is why the field
# is NOT sent by default and this variable exists.
#
# Setting it to 1 sends the field. Measured on a provider that reasons by default,
# on a question that needs reasoning: with the field 49-62 output tokens per
# answer, without it 200-600 for the same answer — ten times the cost, paid by
# whoever runs the module. On short questions there is no difference.
LLM_DISABLE_THINKING=

# HOW READING INTRODUCES ITSELF, and in which language it asks.
#
# Unset, the `User-Agent` names the module and its repository: an administrator
# reading their log sees the code that is walking their site. Put your own
# address here if you answer for this traffic — the complaint should reach
# whoever runs the module, not whoever wrote it.
READ_CONTACT=

# `Accept-Language` for reading. Unset by default, deliberately: a language fixed
# here decides which version of a page the web serves, and nothing in the answer
# says a choice was made. Set it when the instance really does work in one
# language. Example, for Russian-language reading:
#     READ_LANGUAGES=ru-RU,ru;q=0.9,en;q=0.8
# The metasearch has its own equivalent — `default_lang` in searxng/settings.yml,
# commented out for the same reason.
READ_LANGUAGES=
